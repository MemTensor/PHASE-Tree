# =============================================================================
# PHASE-Tree environment configuration (PLACEHOLDER VALUES — DO NOT COMMIT REAL KEYS)
# -----------------------------------------------------------------------------
# This file is committed to the repository as a template.  For local use, either:
#   * edit this file in place and avoid committing your changes, OR
#   * copy it to `.env.local` (git-ignored) and put your real keys there.
# All three model groups can point to the same provider/endpoint, or to
# different ones (e.g. OpenAI for the LLM judge + a local server for embeddings).
# =============================================================================

# LLM API used by the attribute-tree extraction and preprocessing pipeline
# (preprocessing/, src/tree_pipeline/).
LLM_MODEL=gpt-4.1
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# Judge model API used by evaluation/judge.py (LLM-as-Judge scoring).
JUDGE_MODEL=gpt-4.1
JUDGE_API_KEY=sk-your-judge-api-key-here
JUDGE_BASE_URL=https://api.openai.com/v1

# Embedding model API used by evaluation/judge.py for response-vs-reference
# cosine similarity. The default `text-embedding-3-small` is the model used
# in the paper; any OpenAI-compatible embedding endpoint works.
EMBED_MODEL=text-embedding-3-small
EMBED_API_KEY=sk-your-embedding-api-key-here
EMBED_BASE_URL=https://api.openai.com/v1
